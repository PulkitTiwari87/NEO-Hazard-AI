# Raw and processed data are pipeline outputs, not source-controlled artifacts.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained model artifacts are regenerated by src/models/train.py.
model_registry/*
!model_registry/.gitkeep

# Generated benchmark/evaluation outputs.
results/*
!results/.gitkeep

experiments/results/*
!experiments/results/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

.DS_Store
*.egg-info/
