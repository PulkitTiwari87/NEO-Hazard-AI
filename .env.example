# NASA API key from https://api.nasa.gov (DEMO_KEY works but is rate-limited to
# 30 requests/hour and 50/day; register for a personal key for real ingestion runs).
# Never commit a real key to source control.
NASA_API_KEY=DEMO_KEY

# Base URL for the NASA NeoWs (Near Earth Object Web Service) API.
NASA_NEOWS_BASE_URL=https://api.nasa.gov/neo/rest/v1

# Base URL for the JPL Small-Body Database Query API (supplementary orbital data source).
NASA_SBDB_BASE_URL=https://ssd-api.jpl.nasa.gov/sbdb_query.api

# Local data-pipeline directories (relative to repository root unless absolute).
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODEL_REGISTRY_DIR=model_registry
RESULTS_DIR=results

# Random seed used for train/test splitting and stochastic models, for reproducibility.
RANDOM_SEED=42
